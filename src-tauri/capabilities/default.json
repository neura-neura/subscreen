{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos predeterminados para la ventana principal.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "libmpv:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "updater:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/neura-neura/subscreen"
        }
      ]
    }
  ]
}
